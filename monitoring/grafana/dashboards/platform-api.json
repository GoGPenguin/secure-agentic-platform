{
  "uid": "platform-api-overview",
  "title": "Platform API Overview",
  "description": "Git-managed Platform API telemetry. No data is distinct from zero errors; inspect target health before interpreting traffic panels.",
  "tags": [
    "platform-api",
    "gitops"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m"
    ]
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 4,
      "type": "stat",
      "title": "Target Health",
      "description": "Worst scrape health across currently discovered Platform API targets: 1 = all up, 0 = at least one down. No series means no discovered target telemetry. This does not detect a missing replica when other replicas remain discovered.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "noValue": "No telemetry",
          "color": {
            "mode": "thresholds"
          },
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min(up{job=\"platform-api\"})",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": "Target health"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Current Request Rate",
      "description": "Completed HTTP responses across all discovered Platform API replicas, including health and metrics routes. Hidden when any discovered target is down or target telemetry is missing. Existing counters with no new responses show zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"platform-api\"}[$__rate_interval])) and on() (min(up{job=\"platform-api\"}) == 1)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": "Requests/s"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Current HTTP 5xx Error Percentage",
      "description": "HTTP 5xx responses as a percentage of all completed responses. Missing 5xx series count as zero only when request rates exist and total traffic is positive. No traffic, missing request telemetry or any discovered target down shows no value.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No traffic / telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "max": 100,
          "decimals": 2
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (sum(rate(http_requests_total{job=\"platform-api\",status_code=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_requests_total{job=\"platform-api\"}[$__rate_interval])))) / (sum(rate(http_requests_total{job=\"platform-api\"}[$__rate_interval])) > 0)) and on() (min(up{job=\"platform-api\"}) == 1)",
          "editorMode": "code",
          "range": false,
          "instant": true,
          "legendFormat": "5xx %"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate",
      "description": "Completed HTTP responses across all discovered Platform API replicas, including health and metrics routes. Hidden when any discovered target is down or target telemetry is missing. Existing counters with no new responses show zero.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "Requests / second"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"platform-api\"}[$__rate_interval])) and on() (min(up{job=\"platform-api\"}) == 1)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "Requests/s"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP 5xx Error Percentage",
      "description": "HTTP 5xx responses as a percentage of all completed responses. Missing 5xx series count as zero only when request rates exist and total traffic is positive. No traffic, missing request telemetry or any discovered target down shows no value.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "noValue": "No traffic / telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "Errors (%)"
          },
          "max": 100
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(100 * (sum(rate(http_requests_total{job=\"platform-api\",status_code=~\"5..\"}[$__rate_interval])) or (0 * sum(rate(http_requests_total{job=\"platform-api\"}[$__rate_interval])))) / (sum(rate(http_requests_total{job=\"platform-api\"}[$__rate_interval])) > 0)) and on() (min(up{job=\"platform-api\"}) == 1)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "5xx %"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 Request Latency",
      "description": "p95 over histogram buckets aggregated across replicas before quantile calculation. Unit: seconds. No observations yields no value. Hidden if any discovered target is down or target telemetry is missing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No traffic / telemetry",
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "axisPlacement": "left",
            "axisLabel": "Latency (seconds)"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"platform-api\"}[$__rate_interval]))) and on() (min(up{job=\"platform-api\"}) == 1)",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "p95"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    }
  ]
}
